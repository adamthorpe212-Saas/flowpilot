# Copy to .env.local and fill in. .env.local is gitignored.
#
# Nothing here is required to build the project or run the marketing site —
# every value is read lazily, so a missing one fails only when something
# actually needs it, with a message naming the variable.

# --- Supabase -----------------------------------------------------------
# Project Settings > API
# URL and anon key are publishable and end up in the browser bundle. Row-level
# security is what protects the data, not the secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Bypasses row-level security — server-side only, never imported into a
# client component. Used by the Twilio and Stripe webhooks, which have no user
# session and therefore cannot rely on RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Twilio -------------------------------------------------------------
# Console dashboard. TWILIO_PHONE_NUMBER is for local testing only — in
# production each business gets its own provisioned number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Irish numbers carry an address requirement. Set these once the regulatory
# bundle exists; provisioning passes them through when present.
# The area code the regulatory bundle covers, so provisioning only searches
# numbers it can actually buy. Follows the registered address. Defaults to 01.
TWILIO_NUMBER_AREA=

# Overrides the text-to-speech voice. Leave empty to use Twilio's built-in one:
# named Polly and Google voices are refused on some accounts with a misleading
# "Say: Invalid text" error, which kills every call.
TWILIO_VOICE=

TWILIO_ADDRESS_SID=
TWILIO_BUNDLE_SID=

# How outbound SMS is sent — the confirmation text and the job alert.
#
# NOT the provisioned number: Irish numbers have no SMS capability at all, so
# sending from one fails every time. Use a Messaging Service (preferred, Twilio
# picks the sender) or a ComReg-registered alphanumeric sender ID such as
# "FlowPilot", 3-11 characters. Unregistered sender IDs are labelled
# "Likely Scam" on delivery in Ireland.
#
# Without one of these, no confirmation or job alert is sent at all.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_SENDER_ID=

# --- Model --------------------------------------------------------------
# Drives the qualification conversation. Without it the receptionist still
# answers, but falls back to taking a message rather than qualifying.
# Which voice provider answers calls. Empty uses the built-in Twilio + model
# pipeline, which is what runs today. Set to "elevenlabs" once a key exists —
# an unknown or unconfigured value falls back rather than dropping calls.
VOICE_PROVIDER=
ELEVENLABS_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Stripe -------------------------------------------------------------
# Price IDs differ between test and live mode, which is why they are
# environment values rather than hardcoded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Site ---------------------------------------------------------------
# Absolute origin, used for auth redirects and for the webhook URLs Twilio
# signs against. Leave blank locally (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Email -------------------------------------------------------------
# Job alerts by email. Worth setting even if SMS is planned: email needs no
# regulator, so it delivers jobs while the ComReg sender ID is still pending —
# without it, a job can be captured perfectly and never reach anyone.
# resend.com → API key, and a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=

# --- Scheduled jobs ----------------------------------------------------
# Vercel sends this as a bearer token to the cron endpoints. Without it the
# reclaim job refuses to run — it deletes phone numbers, so an unauthenticated
# version of it would be a way for anyone to disconnect every customer.
# Any long random string.
CRON_SECRET=
